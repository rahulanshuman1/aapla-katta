# ---------- Server ----------
PORT=5000
NODE_ENV=production
# Comma separated list of allowed frontend origins (your Vercel URL + custom domain)
CLIENT_URL=https://your-site.vercel.app

# ---------- Database ----------
MONGODB_URI=

# ---------- Auth ----------
JWT_SECRET=
JWT_EXPIRES_IN=7d
# First admin account (created automatically on server start)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
# Where "new order" alerts are sent (defaults to ADMIN_EMAIL)
ORDER_NOTIFY_EMAIL=

# ---------- Razorpay ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------- Email (pick ONE provider) ----------
# Render's free plan blocks SMTP ports, so Brevo/Resend (HTTPS API) is recommended in production.
MAIL_FROM_NAME=Aapla Katta
MAIL_FROM_EMAIL=
# Option A: Brevo  (https://www.brevo.com - free 300 mails/day, verify a single sender, no domain needed)
BREVO_API_KEY=
# Option B: Resend (https://resend.com - needs a verified domain to email customers)
RESEND_API_KEY=
# Option C: SMTP (fine locally, or on paid Render)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ---------- Mobile push notifications (optional) ----------
# Firebase console → Project settings → Service accounts → Generate new private key.
# Paste the JSON as ONE line, or (easier on Render) paste it base64-encoded:  base64 -w0 serviceAccount.json
FIREBASE_SERVICE_ACCOUNT=

# ---------- Mobile OTP sign-in via SMS (pick ONE; leave all empty to hide the option) ----------
# Brevo (same BREVO_API_KEY as email) – needs SMS credits + a sender name in Brevo:
BREVO_SMS_SENDER=
# Twilio (trial works only for numbers you verified in the Twilio console):
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Fast2SMS / 2Factor:
FAST2SMS_API_KEY=
TWOFACTOR_API_KEY=
# Force a provider (brevo|twilio|fast2sms|2factor) or SMS_PROVIDER=log to just print codes in the server log while testing
SMS_PROVIDER=
